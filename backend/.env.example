# MongoDB Atlas connection string.
# Use the SRV format from Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/talktotext

# The database name (must match the one in MONGO_URI if present).
DATABASE_NAME=talktotext

# Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=api-key-here

# Gemini model used for meeting analysis / summarization.
GEMINI_MODEL=gemini-3.6-flash

# Gemini model used for cloud transcription.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Maximum number of analysis tokens per chat (used for chunked analysis).
MAX_ANALYSIS_TOKENS=5000

# Hard upload ceiling in megabytes (default 250).
# MAX_UPLOAD_MB=250

# MongoDB connection timeouts (milliseconds). Optional.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=60000

# Set to 1 to enable Flask debug mode (stack traces exposed). Default 0.
# FLASK_DEBUG=0
